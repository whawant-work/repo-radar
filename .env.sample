# repo-radar .env sample
# Copy to .env and edit values. Keys here can be overridden by real environment variables.

# Core schedule
TIMEZONE=Asia/Seoul
DAILY_AT=09:00
QUIET_HOURS=22:00-08:00

# GitHub
# Personal access token with repo:read as needed (optional for public-only)
GITHUB_TOKEN=

# Repositories
# Manage repositories in config/repos.list (one owner/name per line)

# Rules file path (optional)
RULES_FILE=./config/rules.yaml

# GitHub Pages publishing
GH_PAGES_REPO=you/repo-radar-pages
GH_PAGES_BRANCH=gh-pages
BASE_URL=https://you.github.io/repo-radar-pages

# Email (SMTP default)
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_TO=me@example.com,team@example.com
